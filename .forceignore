# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Metadata ruidosa en el sync prod->repo (reordena en cada retrieve).
# Ver docs/07-sync-prod-a-main.md paso 4.
**/profiles/**
**/standardValueSets/**
**/appMenus/**
**/installedPackages/**

# Data Cloud: config de plataforma (field mappings) que el deploy rechaza
# fuera del org donde Data Cloud esta configurado. No se gestiona por source.
**/cleanDataServices/**

# Layouts estandar de chat (LiveChatTranscript): el retrieve captura
# construcciones que el deploy rechaza (height+width, section CustomLinks).
# No son parte del flujo; se gestionan en el org, no por source.
**/layouts/LiveChatTranscript*

# NotificationTypeConfig: trae tipos de notificacion que dependen de las
# features de cada org (activity_team_member no existe en Release) y rompe el
# deploy. Se gestiona en el org, no por source.
**/notificationTypeConfig/**

# Search settings: PROD entrega resultsPerPageCount=0 (Actividad_de_Agenda__c)
# y QA lo rechaza (debe estar entre 5 y 50). Se gestiona en el org.
**/settings/Search.settings-meta.xml
