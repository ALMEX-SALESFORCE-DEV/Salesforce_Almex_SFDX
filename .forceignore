package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Metadata ruidosa en el sync prod->repo (reordena en cada retrieve).
# Ver docs/07-sync-prod-a-main.md paso 4.
**/profiles/**
!**/profiles/Admin.profile-meta.xml
!**/profiles/Gerencia y Dirección Comercial.profile-meta.xml
!**/profiles/Supervisor y Ejecutivo Comercial.profile-meta.xml
**/standardValueSets/**
**/appMenus/**
**/installedPackages/**

# Data Cloud: config de plataforma (field mappings) que el deploy rechaza
# fuera del org donde Data Cloud esta configurado. No se gestiona por source.
**/cleanDataServices/**

# Layouts estandar de chat (LiveChatTranscript): el retrieve captura
# construcciones que el deploy rechaza (height+width, section CustomLinks).
# No son parte del flujo; se gestionan en el org, no por source.
**/layouts/LiveChatTranscript*
