<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validar_cuenta_del_cliente</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Customer_Site_Name__c)),  
  Quote.Opportunity.Account.Id &lt;&gt; Customer_Site_Name__r.Cuenta__r.Id
)</errorConditionFormula>
    <errorMessage>Esta sucursal seleccionada no pertenece a la cuenta del presupuesto</errorMessage>
</ValidationRule>
