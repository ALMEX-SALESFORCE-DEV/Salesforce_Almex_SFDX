    <formulas>
        <name>NumeroDeLinea</name>
        <dataType>Number</dataType>
        <expression>VALUE(
    TRIM(
        LEFT(
            RIGHT(
                {!NoPedido}, 
                LEN({!NoPedido}) - FIND(&quot;Línea de pedido: &quot;, {!NoPedido}) - 16
            ),
            FIND(&quot; &quot;, 
                RIGHT(
                    {!NoPedido}, 
                    LEN({!NoPedido}) - FIND(&quot;Línea de pedido: &quot;, {!NoPedido}) - 16
                )
            )
        )
    )
)</expression>
