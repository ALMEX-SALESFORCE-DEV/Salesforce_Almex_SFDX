    <formulas>
        <name>NoLinea</name>
        <dataType>Number</dataType>
        <expression>VALUE(
    TRIM(
        LEFT(
            RIGHT(
                {!NoLineaPedido}, 
                LEN({!NoLineaPedido}) - FIND(&quot;Línea de pedido: &quot;, {!NoLineaPedido}) - 16
            ),
            FIND(&quot; &quot;, 
                RIGHT(
                    {!NoLineaPedido}, 
                    LEN({!NoLineaPedido}) - FIND(&quot;Línea de pedido: &quot;, {!NoLineaPedido}) - 16
                )
            )
        )
    )
)</expression>
